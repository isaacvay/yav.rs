{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Yav Manifest",
  "scopeName": "source.yavml",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#key-values" }
  ],
  "repository": {
    "comments": {
      "match": "(#).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.yavml" }
      },
      "name": "comment.line.number-sign.yavml"
    },
    "sections": {
      "patterns": [
        {
          "match": "^\x5B\x5B\\s*([a-zA-Z0-9_.-]+)\\s*\x5D\x5D",
          "captures": {
            "0": { "name": "entity.name.section.table.array.yavml" },
            "1": { "name": "keyword.other.section.array.yavml" }
          }
        },
        {
          "match": "^\x5B\\s*(package|server|tailwind|motion|pwa|build|dependencies|scripts|assets)\\s*\x5D",
          "captures": {
            "0": { "name": "entity.name.section.yavml" },
            "1": { "name": "keyword.control.section.builtin.yavml" }
          }
        },
        {
          "match": "^\x5B\\s*([a-zA-Z0-9_.-]+)\\s*\x5D",
          "captures": {
            "0": { "name": "entity.name.section.yavml" },
            "1": { "name": "entity.name.type.section.yavml" }
          }
        }
      ]
    },
    "key-values": {
      "patterns": [
        {
          "match": "\\b(name|version|description|authors|license|repository|homepage|keywords|port|host|cors|https|tls_cert|tls_key|enabled|reduced_motion|theme_color|background_color|display|start_url|out_dir|public_dir|minify|fingerprint|input|output|favicon|fonts|static_dirs|dev|build|test|lint|deploy)\\b(?=\\s*=)",
          "name": "support.type.property-name.yavml"
        },
        {
          "match": "\\b([a-zA-Z0-9_.-]+)\\b(?=\\s*=)",
          "name": "variable.other.property.yavml"
        },
        {
          "include": "#values"
        }
      ]
    },
    "values": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#booleans" },
        { "include": "#numbers" },
        { "include": "#arrays" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yavml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yavml",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[\\\\\"'abfnrtv])"
            }
          ]
        },
        {
          "name": "string.quoted.single.yavml",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "booleans": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.yavml"
    },
    "numbers": {
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.yavml"
    },
    "arrays": {
      "begin": "\x5B",
      "end": "\x5D",
      "patterns": [
        { "include": "#comments" },
        { "include": "#values" }
      ]
    }
  }
}
