# Yav Environment Configuration Example
# Copy this file to .env and adjust values for your deployment.

# Database URL (supported: sqlite:path, postgres://..., postgresql://...)
DATABASE_URL=sqlite:app.db

# Session encryption secret (REQUIRED in production — at least 32 random bytes)
# Generate one with: openssl rand -hex 32
# Or: head -c 32 /dev/urandom | xxd -p -c 32
SESSION_SECRET=

# Application environment
YAV_ENV=development

# Server port
PORT=3000

# Logging level
RUST_LOG=info
